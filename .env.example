# FRED API Key (get for free at https://fred.stlouisfed.org/)
FRED_API_KEY=

# Data Configuration
DAYS_HISTORY=3650

# Storage Configuration
DATA_DIR=data

# Email Alerts & SMTP Configuration

# Z-Score threshold to trigger alerts
ALERT_ZSCORE_THRESHOLD=2.0

# SMTP server and port (example for Gmail/Google Workspace)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Authentication credentials for the sender email
SMTP_USERNAME=
# TIP: If using Gmail, use an "App Password", not your real password
SMTP_PASSWORD=

# Email addresses for dispatching alerts
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=

# Prefect Backend Database Credentials
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

TU_TOKEN_DE_CLOUDFLARE=